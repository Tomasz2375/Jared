@inherits DialogBase<WorkLogAddDto>

<h3>Add work time</h3>
<div class="form-modal-base">
    <div class="form-modal-small">
        <EditForm Model="@WorkLog" OnValidSubmit="save">
            <FluentValidationValidator />
            <div class="form-modal-header">
                <h4 class="form-modal-title">WorkLog</h4>
                <button class="btn form-close" @onclick="cancel">✖</button>
            </div>
            <div class="form-modal-content-small">
                <div class="form-modal-details">
                    <InputDateField
                        @bind-Value="@(WorkLog.WorkDate)"
                        Label="Work date"
                        Id="workdate"
                        ValidationFor="(() => WorkLog.WorkDate)" />
                    <div class="form-modal-tabs">
                        <InputNumberField
                            @bind-Value="@(WorkLog.Hours)"
                            Label="Hours"
                            Id="minutes"
                            ValidationFor="(() => WorkLog.Hours)" />
                        <InputNumberField
                            @bind-Value="@(WorkLog.Minutes)"
                            Label="Minutes"
                            Id="minutes"
                            ValidationFor="(() => WorkLog.Minutes)" />
                    </div>
                </div>
            </div>
            <div class="form-modal-footer">
                <button class="btn btn-primary-dialog" type="submit">Add</button>
                <button class="btn btn-danger" @onclick="cancel">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>
