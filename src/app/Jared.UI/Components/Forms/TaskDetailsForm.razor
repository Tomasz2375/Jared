@inject IMediator Mediator
@inject INotificationService NotificationService
@inherits DialogBase

@if (Dto is null)
{
    return;
}

<div class="form-modal-base">
    <div class="form-modal">
        <EditForm Model="@Dto">
            <FluentValidationValidator />
            <div class="form-modal-header">
                <h4 class="form-modal-title">@Dto.Code</h4>
                <button class="btn form-close" @onclick="cancel">✖</button>
            </div>
            <div class="form-modal-content">
                <div class="form-modal-tabs" style="position:sticky; top:0;">
                    <TabForm Id="0" Label="Details" ActiceTab="@tabNumber" OnTabSelected="@(x => tabNumber = x)" />
                    <TabForm Id="1" Label="History" ActiceTab="@tabNumber" OnTabSelected="@(x => tabNumber = x)" />
                    <TabForm Id="2" Label="Worklogs" ActiceTab="@tabNumber" OnTabSelected="@(x => tabNumber = x)" />
                </div>
                <div class="form-modal-details">
                    @switch (tabNumber)
                    {
                        case 1:
                            <TaskDetailsHistory TaskHistoryDtos="@Dto.TaskHistories" />
                            break;
                        case 2:
                            <TaskDetailsWorkLog Dto="@Dto" />
                            break;
                        default:
                            <TaskDetailsDetails
                                Dto="@Dto"
                                Projects="@projects"
                                OnProjectChanged="@getTasks"
                                Tasks="@tasks"
                                Users="@users" />
                            break;
                    }
                </div>
            </div>
            <div class="form-modal-footer">
                <CancelButton Id="cancel-button" OnClick="cancel" Text="Cancel" />
                <ConfirmButton
                    Id="save-and-stay-button"
                    OnClick="@(() => save(false))"
                    Text="Save & Stay" />
                <ConfirmButton
                    Id="save-button"
                    OnClick="@(() => save(true))"
                    Text="Save" />
            </div>
        </EditForm>
    </div>
</div>
