@using Jared.Dtos.TaskHistories;

@if (TaskHistoryDtos is null)
{
    return;
}

<div style="overflow-y: scroll; max-height: 500px">
<table class="table">
        <thead style="position: sticky; top:0; background-color:var(--background-1)">
            <tr>
                <th>Id</th>
                <th>User id</th>
                <th>Property</th>
                <th>Old value</th>
                <th>New value</th>
                <th>Changed at</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var history in TaskHistoryDtos)
            {
                <tr>
                    <td>@history.Id</td>
                    <td>@history.UserId</td>
                    <td>@history.Property</td>
                    <td>@history.OldValue</td>
                    <td>@history.NewValue</td>
                    <td>@history.CreatedAt</td>
                </tr>
            }
        </tbody>
    </table>
</div>
