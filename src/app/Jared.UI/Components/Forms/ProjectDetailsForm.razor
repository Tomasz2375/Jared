@inject IMediator Mediator
@inject INotificationService NotificationService
@inherits DialogBase

@if (Dto is null)
{
    return;
}

<div class="form-modal-base">
    <div class="form-modal">
        <EditForm Model="@Dto">
            <FluentValidationValidator />
            <div class="form-modal-header">
                <h4 class="form-modal-title">@Dto.Title</h4>
                <button class="btn form-close" @onclick="cancel">✖</button>
            </div>
            <div class="form-modal-content">
                <div class="form-modal-details">
                    <div class="form-modal-tabs">
                        <InputTextField 
                            @bind-Value="@Dto.Title"
                            Id="title"
                            Placeholder="Title" />
                    </div>
                    <div class="form-modal-tabs">
                        <InputTextField 
                            @bind-Value="@Dto.Code"
                            Id="code"
                            Placeholder="Code" />
                        <InputTextField 
                            @bind-Value="@Dto.Color"
                            Id="color"
                            Placeholder="Color" />
                    </div>
                    <div class="form-modal-tabs">
                        <InputTextAreaField
                            @bind-Value="@Dto.Description"
                            Id="description"
                            Placeholder="Description"/>
                    </div>
                </div>
            </div>
            <div class="form-modal-footer">
                <CancelButton Id="cancel-button" OnClick="cancel" Text="Cancel" />
                <ConfirmButton
                    Id="save-and-stay-button"
                    OnClick="@(() => save(false))"
                    Text="Save & Stay" />
                <ConfirmButton
                    Id="save-button"
                    OnClick="@(() => save(true))"
                    Text="Save" />
            </div>
        </EditForm>
    </div>
</div>
