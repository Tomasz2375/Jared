@inject IUserService UserService
@inject IDialogService DialogService

<InputTextField @bind-Value="@Dto.Title" Id="title" Label="Title" ValidationFor="(() => Dto.Title)" />
<InputTextAreaField @bind-Value="@Dto.Description" Id="description" Label="Description" Row="5" ValidationFor="(() => Dto.Description)" />

<div class="form-modal-tabs">
    <InputSelectList
        @bind-Value="Dto.ProjectId"
        Items="@Projects.ToDictionary(x => x.Id, x => x.Title)"
        TKey="int"
        Id="project"
        Label="Project"
        ValidationFor="(() => Dto.ProjectId)" />
    <InputSelectList
        @bind-Value="Dto.ParentId"
        Items="@Tasks.Where(x => x.ProjectId == Dto.ProjectId).ToDictionary(x => x.Id, x => x.Title)"
        TKey="int?"
        Id="parent"
        Label="Parent task"
        Disabled="@(Dto.ProjectId == 0)"
        ValidationFor="(() => Dto.ParentId)" />
</div>
<div class="form-modal-tabs">
    <InputSelectEnum @bind-Value="Dto.Priority" ValidationFor="(() => Dto.Priority)" Id="priority" Label="Priority" />
    <InputSelectEnum @bind-Value="Dto.Status" ValidationFor="(() => Dto.Status)" Id="status" Label="Status" />
    <InputDateField @bind-Value="Dto.Deadline" Label="Deadline" Id="deadline" ValidationFor="(() => Dto.Deadline)" />
</div>
<div class="form-modal-tabs">
    <LabelValueDisplay Id="created-at" Label="Created at" Value="@Dto.CreatedAt.ToString()" />
    <LabelValueDisplay Id="start-date" Label="Start date" Value="@Dto.StartDate.ToString()" />
    <LabelValueDisplay Id="end-date" Label="End date" Value="@Dto.EndDate.ToString()" />
</div>
<div class="form-modal-tabs">
    <InputSelectList
        @bind-Value="Dto.CreatedById"
        Items="@Users.ToDictionary(x => x.Id, x => $"{x.FirstName} {x.LastName}")"
        TKey="int?"
        Id="created-by"
        Label="Created by"
        ValidationFor="(() => Dto.CreatedById)" />
    <InputSelectList
        @bind-Value="Dto.AssignedToId"
        Items="@Users.ToDictionary(x => x.Id, x => $"{x.FirstName} {x.LastName}")"
        TKey="int?"
        Id="assigned-to"
        Label="Assigned to"
        ValidationFor="(() => Dto.AssignedToId)" />
</div>

<div class="form-modal-tabs">
    <div style="width:50%">
        <InputTimeSpanField @bind-Value="Dto.EstimatedTime" Label="Estimated time" Id="estimated-time" ValidationFor="(() => Dto.EstimatedTime)" />
    </div>
    <InputTimeSpanField @bind-Value="Dto.TotalWorkTime" Label="Total work time" Id="total-work-time" Disabled="true" ValidationFor="(() => Dto.TotalWorkTime)" />
    <div style="position:relative; bottom: -12px;">
        <button type="button" class="btn btn-simple-dialog" @onclick="addWorkLog">+</button>
    </div>
</div>
