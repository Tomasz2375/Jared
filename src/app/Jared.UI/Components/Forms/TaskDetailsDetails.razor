@inject IUserService UserService
@inject IDialogService DialogService

<div class="form-modal-tabs">
    <InputTextField
        @bind-Value="@Dto.Title"
        Id="title"
        Placeholder="Title" />
</div>
<div class="form-modal-tabs">
    <InputTextAreaField
        @bind-Value="@Dto.Description"
        Id="description"
        Placeholder="Description"/>
</div>
<div class="form-modal-tabs">
        <InputSelectList
            Value="Dto.ProjectId"
            ValueChanged="projectChanged"
            ValueExpression="() => Dto.ProjectId"
            Items="@Projects.ToDictionary(x => x.Id, x => x.Title)"
            TKey="int"
            Id="project"
            Placeholder="Project" />
        <InputSelectList
            @bind-Value="Dto.ParentId"
            Items="@Tasks.Where(x => x.ProjectId == Dto.ProjectId && x.Id != Dto.Id).ToDictionary(x => x.Id, x => x.Title)"
            TKey="int?"
            Id="parent"
            Placeholder="Parent task"
            Disabled="@(Dto.ProjectId == 0)" />
</div>
<div class="form-modal-tabs">
    <InputSelectEnum @bind-Value="Dto.Priority" Id="priority" Placeholder="Priority" />
    <InputSelectEnum @bind-Value="Dto.Status" Id="status" Placeholder="Status" />
    <InputDateField @bind-Value="Dto.Deadline" Placeholder="Deadline" Id="deadline" />
</div>
<div class="form-modal-tabs">
    <InputDateField
        @bind-Value="Dto.CreatedAt"
        TValue="DateTime"
        Id="created-at"
        Placeholder="Created at"
        Disabled="true" />
    <InputDateField
        @bind-Value="@Dto.StartDate"
        Id="start-date"
        Placeholder="Start date"
        Disabled="true" />
    <InputDateField
        @bind-Value="@Dto.EndDate"
        Id="end-date"
        Placeholder="End date"
        Disabled="true" />
</div>
<div class="form-modal-tabs">
    <InputSelectList
        @bind-Value="Dto.CreatedById"
        Items="@Users.ToDictionary(x => x.Id, x => $"{x.FirstName} {x.LastName}")"
        TKey="int?"
        Id="created-by"
        Placeholder="Created by" />
    <InputSelectList
        @bind-Value="Dto.AssignedToId"
        Items="@Users.ToDictionary(x => x.Id, x => $"{x.FirstName} {x.LastName}")"
        TKey="int?"
        Id="assigned-to"
        Placeholder="Assigned to" />
</div>

<div class="form-modal-tabs">
    <div style="width:50%">
        <InputTimeSpanField
            @bind-Value="Dto.EstimatedTime"
            Placeholder="Estimated time"
            Id="estimated-time" />
    </div>
    <InputTimeSpanField
        @bind-Value="Dto.TotalWorkTime"
        Placeholder="Total work time"
        Id="total-work-time"
        Disabled="true" />
    <div style="position:relative; bottom: -12px;">
        <button type="button" class="btn btn-simple-dialog" @onclick="addWorkLog">+</button>
    </div>
</div>
