@inject IMediator Mediator
@inject IUserService UserService
@inject INotificationService NotificationService
@inherits DialogBase

<div class="form-modal-base">
    <div class="form-modal">
        <EditForm Model="@Dto"  OnValidSubmit="save">
            <FluentValidationValidator />
            <div class="form-modal-header">
                <h4 class="form-modal-title">Create task</h4>
                <button class="btn form-close" @onclick="cancel">✖</button>
            </div>
            <div class="form-modal-content">
                <div class="form-modal-details">
                    <div class="form-modal-tabs">
                        <InputTextField
                            @bind-Value="@Dto.Title"
                            Id="title"
                            Placeholder="Title" />
                    </div>
                    <div class="form-modal-tabs">
                        <InputTextAreaField
                            @bind-Value="@Dto.Description"
                            Id="description"
                            Placeholder="Description"/>
                    </div>
                    <div class="form-modal-tabs">
                        <InputSelectList
                            Value="@(Dto.ProjectId)"
                            ValueChanged="@(onProjectChanged)"
                            ValueExpression="() => Dto.ProjectId"
                            Items="@projects.ToDictionary(x => x.Id, x => x.Title)"
                            TKey="int"
                            Id="project"
                            Placeholder="Project"/>
                        <InputSelectList
                            @bind-Value="@Dto.ParentId"
                            Items="@tasks.Where(x => x.ProjectId == Dto.ProjectId).ToDictionary(x => x.Id, x => x.Title)"
                            TKey="int?"
                            Id="parent"
                            Placeholder="Parent task"
                            Disabled=@(Dto.ProjectId == 0) />
                    </div>
                    <div class="form-modal-tabs">
                        <InputSelectList
                            @bind-Value="@Dto.CreatedById"
                            Items="@users.ToDictionary(x => x.Id, x => $"{x.FirstName} {x.LastName}" )"
                            TKey="int?"
                            Id="created-by"
                            Placeholder="Created by"
                            Disabled=true />
                        <InputSelectList
                            @bind-Value="@Dto.AssignedToId"
                            Items="@users.ToDictionary(x => x.Id, x => $"{x.FirstName} {x.LastName}" )"
                            TKey="int?"
                            Id="assigned-to"
                            Placeholder="Assigned to" />
                    </div>
                    <div class="form-modal-tabs">
                        <InputSelectEnum
                            @bind-Value="@(Dto.Priority)"
                            Id="priority"
                            Placeholder="Priority" />
                        <InputSelectEnum
                            @bind-Value="@(Dto.Status)"
                            Id="status"
                            Placeholder="Status" />
                        <InputDateField
                            @bind-Value="@(Dto.Deadline)"
                            Placeholder="Deadline"
                            Id="deadline" />
                    </div>
                </div>
            </div>
            <div class="form-modal-footer">
                <button type="submit" class="btn btn-primary-dialog">Save</button>
                <button class="btn btn-danger" @onclick="cancel">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>
