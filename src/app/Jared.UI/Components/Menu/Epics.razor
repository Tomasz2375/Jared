@inject IDialogService DialogService

<div class="dropdown">
    <button @onclick="toggleUserMenu"
            @onfocusout="hideUserMemu"
            class="btn dropdown-btn dropdown-toggle">
        Epics
    </button>
    <div class="dropdown-menu @userMenuCssClass">
        <AuthorizeView>
            <Authorized>
                <button class="dropdown-item" @onclick="(createEpic)">Create epic</button>
                <a href="epics" class="dropdown-item">All epics</a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>
