@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject IDialogService DialogService

<div class="dropdown">
    <button @onclick="toggleUserMenu"
    @onfocusout="hideUserMemu"
    class="btn dropdown-btn dropdown-toggle">
        Tasks
    </button>
    <div class="dropdown-menu @userMenuCssClass">
        <AuthorizeView>
            <Authorized>
                <button class="dropdown-item" @onclick="(createTask)">Create task</button>
                <a @onclick="@(() => NavigationManager.NavigateTo($"Tasks", true))" class="dropdown-item">All tasks</a>
                @foreach (var project in projectsDictionary)
                {
                    <a @onclick="@(() => NavigationManager.NavigateTo($"Tasks/{project.Key}", true))" class="dropdown-item">@project.Value</a>
                }
            </Authorized>
        </AuthorizeView>
    </div>
</div>
