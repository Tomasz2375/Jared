@page "/users"
@inject IMediator Mediator
@attribute [Authorize(Roles = "Admin")]
<h4>Users</h4>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Surname</th>
            <th>Email</th>
            <th>Role</th>
            <th>Save changes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in users)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Email</td>
                <td>
                    <EditForm Model="@user">
                        <InputSelectList
                            @bind-Value="@user.RoleId"
                            Placeholder="Role"
                            TKey="int"
                            Items="@roles"
                            Id=@($"user-{user.Id}-role")
                            ShowDefault="false" />
                    </EditForm>
                </td>
                <td>
                    <ConfirmButton
                        Id="@($"save-button-{user.Id}")"
                        OnClick="@(() => save(user))"
                        Text="Save" />
                </td>
            </tr>
        }
    </tbody>
</table>
