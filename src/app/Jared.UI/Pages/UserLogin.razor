@page "/login"
@inject IJSRuntime JS
@inject NavigationManager Nav
@attribute [AllowAnonymous]

<h4>User login</h4>
<div style="max-width:500px">
    <EditForm Model="@dto" OnValidSubmit="loginUser">
        <FluentValidationValidator />
        <div>
            <InputTextField
                @bind-Value="@dto.Email"
                Id="email"
                Placeholder="Email" />
            <InputTextField
                @bind-Value="@dto.Password"
                Id="password"
                Placeholder="Password"
                IsPassword="true" />
        </div>
        <div>
            <button type="submit" class="btn btn-primary-dialog">Login</button>
        </div>
    </EditForm>
    <div class="text-danger">
        <span>
            @errorMessage
        </span>
    </div>
</div>
