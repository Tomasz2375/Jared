@page "/login"
@inject IJSRuntime JS
@inject INotificationService NotificationService
@inject NavigationManager Nav

<h4>User login</h4>
<div style="max-width:500px">
    <EditForm Model="@dto">
        <FluentValidationValidator />
        <div>
            <InputTextField
                @bind-Value="@dto.Email"
                Id="email"
                Placeholder="Email" />
            <InputTextField
                @bind-Value="@dto.Password"
                Id="password"
                Placeholder="Password"
                IsPassword="true" />
        </div>
        <ConfirmButton Id="login-button" OnClick="@loginUser" Text="Login" Class="btn-right" />
    </EditForm>
</div>
