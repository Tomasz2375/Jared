@page "/register"
@inject IMediator Mediator
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager

<div>
    <h4>User register</h4>
</div>
<div style="max-width:500px">
    <EditForm Model="@Dto">
        <FluentValidationValidator />
        <div>
            <InputTextField
                @bind-Value="@Dto.FirstName"
                Id="firstName"
                Placeholder="First name" />
            <InputTextField
                @bind-Value="@Dto.LastName"
                Id="lastName"
                Placeholder="Last name" />
            <InputDateField
                @bind-Value="@(Dto.DateOfBirth)"
                Id="dateOfBirth"
                Placeholder="Date of birth" />
            <InputTextField
                @bind-Value="@Dto.Email"
                Id="email"
                Placeholder="Email" />
            <InputTextField
                @bind-Value="@Dto.Password"
                Id="password"
                Placeholder="Password"
                IsPassword="true" />
            <InputTextField
                @bind-Value="@Dto.ConfirmPassword"
                Id="confirmPassword"
                Placeholder="Confirm password"
                IsPassword="true" />
        </div>
        <ConfirmButton Id="register-button" OnClick="@registerUser" Text="Register" Class="btn-right" />
    </EditForm>
</div>
