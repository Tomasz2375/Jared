@page "/register"
@using MediatR;
@inject IMediator Mediator
@inject NavigationManager NavigationManager

<div>
    <h4>User register</h4>
</div>
<div style="max-width:500px">
    <EditForm Model="@Dto" OnValidSubmit="registerNewUser">
        <FluentValidationValidator />
        <div>
            <InputTextField
                @bind-Value="@Dto.FirstName"
                Id="firstName"
                Placeholder="First name"
                ValidationFor="(() => Dto.FirstName)" />
            <InputTextField
                @bind-Value="@Dto.LastName"
                Id="lastName"
                Placeholder="Last name"
                ValidationFor="(() => Dto.LastName)" />
            <InputDateField
                @bind-Value="@(Dto.DateOfBirth)"
                Id="dateOfBirth"
                Label="Date of birth"
                ValidationFor="(() => Dto.DateOfBirth)" />
            <InputTextField
                @bind-Value="@Dto.Email"
                Id="email"
                Placeholder="Email"
                ValidationFor="(() => Dto.Email)" />
            <InputTextField
                @bind-Value="@Dto.Password"
                Id="password"
                Placeholder="Password"
                IsPassword="true" />
            <InputTextField
                @bind-Value="@Dto.ConfirmPassword"
                Id="confirmPassword"
                Placeholder="Confirm password"
                IsPassword="true" />
        </div>
        <div>
            <button type="submit" class="btn btn-primary-dialog">Register</button>
        </div>
    </EditForm>
</div>
