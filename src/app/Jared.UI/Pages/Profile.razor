@page "/profile/{Id:int}"
@inject IMediator Mediator
@inject INotificationService NotificationService
@attribute [Authorize]

<div>
    <h4>Profile</h4>
</div>

<div style="max-width:500px">
    <EditForm Model="@userPasswordDto">
        <FluentValidationValidator />
        <h5>Change password</h5>
        <div>
            <InputTextField
                @bind-Value="@userPasswordDto.CurrentPassword"
                Id="password"
                Placeholder="Current password"
                IsPassword="true" />
        </div>
        <div>
            <InputTextField
                @bind-Value="@userPasswordDto.NewPassword"
                Id="new-password"
                Placeholder="New password"
                IsPassword="true" />
        </div>
        <div>
            <InputTextField
                @bind-Value="@userPasswordDto.ConfirmPassword"
                Id="confirm-password"
                Placeholder="Confirm password"
                IsPassword="true" />
        </div>
        <ConfirmButton Id="change-password-button" OnClick="@changePassword" Text="Change password" />
    </EditForm>
    <br />
    <br />
    <EditForm Model="@userUpdateDto">
        <h5>Update user data</h5>
        <InputTextField
            @bind-Value="@userUpdateDto.FirstName"
            Id="firstName"
            Placeholder="First name" />
        <InputTextField
            @bind-Value="@userUpdateDto.LastName"
            Id="lastName"
            Placeholder="Last name" />
        <InputDateField
            @bind-Value="@(userUpdateDto.DateOfBirth)"
            Id="dateOfBirth"
            Placeholder="Date of birth" />
        <ConfirmButton Id="update-user-button" OnClick="@updateUser" Text="Update" />
    </EditForm>
</div>
