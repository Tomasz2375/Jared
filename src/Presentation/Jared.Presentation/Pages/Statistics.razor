@page "/statistics"
@inject ILocalStorageService LocalStorage
@inject IUserService UserService
@inject IMediator Mediator

<h4>Statistics</h4>
<EditForm Model="@month" OnValidSubmit="@(() => getWorkLogs(user, (int)month, year))">
<div class="form-modal-tabs">
        <InputSelectList
            @bind-Value="@user"
            Items="@getUsersDictionary()"
            ValidationFor="(() => user)"
            ShowDefault="false"
            Disabled="@(userRole == "User")"
            Id="user"
            Label="User" />
        <InputSelectEnum
            @bind-Value="@(month)"
            ValidationFor="(() => month)"
            Id="month"
            Label="Month" />
        <InputSelectList
            @bind-Value="@year"
            Items="@getYearDictionary()"
            ValidationFor="(() => year)"
            ShowDefault="false"
            Id="year"
            Label="Year" />
        <div style="position:relative; bottom: -12px;">
            <button type="submit" class="btn btn-primary-dialog">Show</button>
        </div>
    </div>
</EditForm>

@if (!monthWorks.Any() || !projectWorks.Any())
{
    return;
}

<RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12" AlignItems="AlignItems.Center">
    <RadzenStack Style="width: 100%; max-width: 600px; height: 200px">
        <RadzenChart Style="--rz-text-title-color: var(--font-color)">
            <RadzenDonutSeries
                InnerRadius="80"
                Radius="100"
                Data="@projectWorks"
                Fills="@projectWorks.Select(x => x.Color)"
                Title="Time per project"
                CategoryProperty="ProjectTitle"
                Visible="true"
                ValueProperty="Time">
            </RadzenDonutSeries>
        </RadzenChart>
    </RadzenStack>
</RadzenStack>

<div style="overflow-y: scroll; max-height: 250px;">
    <table class="table" style="width: 100%;">
        <thead style="position: sticky; top: 0; background-color:var(--background-2)">
            <tr>
                <th style="width:20%">
                    Code
                </th>
                <th style="width:40%">
                    Title
                </th>
                <th style="width:20%">
                    Project
                </th>
                <th style="width:20%">
                    Time
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in taskWorks)
            {
                <tr>
                    <td>
                        @task.TaskCode
                    </td>
                    <td>
                        @task.TaskTitle
                    </td>
                    <td>
                        @task.ProjectTitle
                    </td>
                    <td>
                        @task.Time
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<RadzenStack class="rz-p-0 rz-p-md-6 rz-p-lg-12">
    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenChart Style="--rz-text-title-color: var(--font-color)">
                @foreach(var project in monthWorks)
                {
                    <RadzenStackedColumnSeries Data="@project.WorkPerDay" Fill="@project.Color" CategoryProperty="Day" Title="@project.ProjectTitle" LineType="LineType.Solid" ValueProperty="Time">
                    </RadzenStackedColumnSeries>
                }
                <RadzenColumnOptions Radius="1" Width="15" />
                <RadzenValueAxis Min="0" Step="1">
                    <RadzenGridLines Visible="true" />
                    <RadzenAxisTitle Text="Time" />
                </RadzenValueAxis>
                <RadzenCategoryAxis >
                    <RadzenAxisTitle Text="Day"/>
                </RadzenCategoryAxis>
            </RadzenChart>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
    